# Build output
build/
out/
cmake-build-*/
compile_commands.json

# Editor / IDE
.vscode/
.idea/
*.swp

# Python (ml/, tests/)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Generated data & artifacts.
# NOTE: .gitignore has no inline comments -- a trailing "# ..." becomes part of
# the pattern and silently matches nothing. Comments get their own line.
# Datasets are large (~10 MB) and fully regenerable; see the README.
ml/data/
*.ll
*.exe
*.obj
*.pdb

# The trained model and the benchmark results ARE committed: the README links
# to the charts, and -O-ml needs a model to be usable out of the box.
!ml/models/
!bench/results/

# Scratch output from manual testing
tmp/
