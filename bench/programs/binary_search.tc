// Repeated binary search over a sorted array.
// Exercises: a short, branch-heavy loop body run very many times.
int search(int a[], int n, int target) {
  int lo = 0;
  int hi = n - 1;
  while (lo <= hi) {
    int mid = (lo + hi) / 2;
    if (a[mid] == target) { return mid; }
    if (a[mid] < target) { lo = mid + 1; } else { hi = mid - 1; }
  }
  return -1;
}

int main() {
  int data[500];
  for (int i = 0; i < 500; i = i + 1) { data[i] = i * 3; }

  int found = 0;
  for (int round = 0; round < 200; round = round + 1) {
    for (int t = 0; t < 500; t = t + 1) {
      if (search(data, 500, t * 3) >= 0) { found = found + 1; }
    }
  }
  print(found);
  return 0;
}
