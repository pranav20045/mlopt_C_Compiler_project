int gcd(int a, int b) { while (b != 0) { int t = b; b = a % b; a = t; } return a; }
int fib(int n) { if (n < 2) { return n; } return fib(n-1) + fib(n-2); }
int limit = 20;
int main() {
  print(gcd(48, 18));
  print(fib(12));
  int primes[20];
  for (int i = 2; i < limit; i = i + 1) {
    if (primes[i] == 0) {
      print(i);
      for (int j = i + i; j < limit; j = j + i) { primes[j] = 1; }
    }
  }
  print(2147483647 + 1);
  return 7;
}
